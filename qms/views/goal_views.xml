<odoo>

    <!-- TREE VIEW -->
    <record id="goal_view_tree" model="ir.ui.view">
        <field name="name">qms.goal.view_tree</field>
        <field name="model">qms.goal</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="date_open" />
                <field name="cancel_date" />
                <field name="date_close" />
                <field name="responsible_id" />
                <field name="state" />
                <field name="approved" />
                <!--<field name="last_measurement_date" />
                <field name="last_measurement_result" />-->
                <field name="last_review_date" />
            </list>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="goal_view_form" model="ir.ui.view">
        <field name="name">qms.goal.view.form</field>
        <field name="model">qms.goal</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_toggle_approved" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="approved">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Not Approved</span>
                            </div>
                        </button>
                        <button name="action_toggle_approved" type="object" class="oe_stat_button" icon="fa-check-square-o" invisible="not approved">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Approved</span>
                            </div>
                        </button>
                        <field name="approved" invisible="1"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date_open" />
                            <field name="responsible_id" />
                        </group>
                        <group>
                            <field name="cancel_date" />
                            <field name="date_close" />
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="state" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" />
                        </page>
                        <page string="Processes">
                            <field name="process_ids" />
                        </page>
                        <page string="Resources">
                            <field name="resource_ids" />
                        </page>
                        <page string="Actions" name="actions">
                            <field name="action_ids" nolabel="1" />
                        </page>
                        <page string="Measurements">
                            <field name="measurement_ids" nolabel="True" readonly="state == 'done'" />
                        </page>
                        <page string="Reviews">
                            <field name="review_ids" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- WINDOW ACTION -->
    <record id="goal_action_view_tree" model="ir.actions.act_window">
        <field name="name">Goals</field>
        <field name="res_model">qms.goal</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- MENU -->
    <menuitem id="menu_open_goal" parent="qms.menu_qms_main" sequence="10" action="goal_action_view_tree"/>

</odoo>
