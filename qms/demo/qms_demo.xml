    <!-- Observations (findings): same required refs as non-conformities. -->
    <record id="demo_obs_compras" model="qms.observation">
        <field name="name">Registros de compra sin firma del responsable (Demo)</field>
        <field name="claimant_id" ref="demo_ip_panza" />
        <field name="interested_party_id" ref="demo_ip_panza" />
        <field name="origin_ids" eval="[(6, 0, [ref('finding_origin_process')])]" />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_compras')])]" />
        <field name="audit_id" ref="demo_audit_compras" />
        <field name="stage_id" ref="finding_stage_done" />
    </record>
    <record id="demo_obs_atencion" model="qms.observation">
        <field name="name">Buzon de sugerencias sin seguimiento formal (Demo)</field>
        <field name="claimant_id" ref="demo_ip_vecino" />
        <field name="interested_party_id" ref="demo_ip_referente" />
        <field
            name="origin_ids"
            eval="[(6, 0, [ref('finding_origin_command_board')])]"
        />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_atencion')])]" />
        <field name="audit_id" ref="demo_audit_atencion" />
        <field name="stage_id" ref="finding_stage_open" />
    </record>
    <record id="demo_obs_capacitacion" model="qms.observation">
        <field name="name">Encuestas de capacitacion sin analisis (Demo)</field>
        <field name="claimant_id" ref="demo_ip_carrasco" />
        <field name="interested_party_id" ref="demo_ip_carrasco" />
        <field name="origin_ids" eval="[(6, 0, [ref('finding_origin_training')])]" />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_capacitacion')])]" />
        <field name="indicator_id" ref="demo_ind_capacitacion" />
    </record>
    <record id="demo_obs_dictamen" model="qms.observation">
        <field name="name">Plantilla de dictamen sin numero de version (Demo)</field>
        <field name="claimant_id" ref="demo_ip_org" />
        <field name="interested_party_id" ref="demo_ip_referente" />
        <field
            name="origin_ids"
            eval="[(6, 0, [ref('finding_origin_internal_audit')])]"
        />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_dictamen')])]" />
        <field name="audit_id" ref="demo_audit" />
        <field name="stage_id" ref="finding_stage_analysis" />
    </record>

    <!-- More goals: state open/closed requires date_open; closed also
         requires date_close (>= date_open). Defined before actions so
         action.goal_id refs resolve at load time. -->
    <record id="demo_goal_capacitacion" model="qms.goal">
        <field name="name">Ejecutar el 90% del plan de capacitacion (Demo)</field>
        <field name="responsible_id" ref="demo_ip_carrasco" />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_capacitacion')])]" />
        <field name="state">open</field>
        <field name="date_open">2025-02-01 09:00:00</field>
        <field name="approved" eval="True" />
    </record>
    <record id="demo_goal_satisfaccion" model="qms.goal">
        <field name="name">Alcanzar 80% de satisfaccion ciudadana (Demo)</field>
        <field name="responsible_id" ref="demo_ip_referente" />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_atencion')])]" />
        <field name="resource_ids" eval="[(6, 0, [ref('demo_res_sistema')])]" />
        <field name="state">closed</field>
        <field name="date_open">2025-01-10 09:00:00</field>
        <field name="date_close">2025-11-30 18:00:00</field>
        <field name="approved" eval="True" />
    </record>
    <record id="demo_goal_transparencia" model="qms.goal">
        <field name="name">Publicar tablero de indicadores trimestral (Demo)</field>
        <field name="responsible_id" ref="demo_ip_quijano" />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_planificacion')])]" />
        <field name="state">open</field>
        <field name="date_open">2025-03-15 10:00:00</field>
    </record>
    <record id="demo_goal_compras" model="qms.goal">
        <field name="name">Reducir compras sin evaluacion previa (Demo)</field>
        <field name="responsible_id" ref="demo_ip_panza" />
        <field name="process_ids" eval="[(6, 0, [ref('demo_proc_compras')])]" />
        <field name="state">draft</field>
    </record>

    <!-- Goal measurements (measurement_date >= expected_date). -->
    <record id="demo_gm_capac" model="qms.goal.measurement">
        <field name="goal_id" ref="demo_goal_capacitacion" />
        <field name="name">Avance 1er semestre (Demo)</field>
        <field name="expected_date">2025-06-01</field>
        <field name="measurement_date">2025-06-20</field>
        <field name="result">goal_with_obs</field>
    </record>
    <record id="demo_gm_satisf" model="qms.goal.measurement">
        <field name="goal_id" ref="demo_goal_satisfaccion" />
        <field name="name">Medicion de cierre (Demo)</field>
        <field name="expected_date">2025-10-01</field>
        <field name="measurement_date">2025-10-15</field>
        <field name="result">goal_no_ok</field>
    </record>
    <record id="demo_gm_transparencia" model="qms.goal.measurement">
        <field name="goal_id" ref="demo_goal_transparencia" />
        <field name="name">Publicacion 1er trimestre (Demo)</field>
        <field name="expected_date">2025-05-01</field>
        <field name="measurement_date">2025-05-05</field>
        <field name="result">goal_ok</field>
    </record>

    <!-- More actions (date_closed >= opening_date), wired to findings,
         goals and hazards. -->
    <record id="demo_action_compras" model="qms.action">
        <field name="name">Reinstaurar evaluacion previa de proveedores (Demo)</field>
        <field name="response_type">correction</field>
        <field name="complexity">high</field>
        <field name="responsible_id" ref="demo_ip_panza" />
        <field name="non_conformity_id" ref="demo_nc_compras" />
        <field name="opening_date">2025-03-25</field>
        <field name="date_closed">2025-05-10</field>
        <field name="stage_id" ref="action_stage_close" />
    </record>
    <record id="demo_action_atencion" model="qms.action">
        <field name="name">Definir circuito de respuesta a reclamos (Demo)</field>
        <field name="response_type">immediate</field>
        <field name="complexity">medium</field>
        <field name="responsible_id" ref="demo_ip_referente" />
        <field name="observation_id" ref="demo_obs_atencion" />
        <field name="opening_date">2025-09-22</field>
        <field name="date_closed">2025-10-30</field>
        <field name="stage_id" ref="action_stage_close" />
    </record>
    <record id="demo_action_capac" model="qms.action">
        <field name="name">Reprogramar el plan anual de capacitacion (Demo)</field>
        <field name="response_type">improvement</field>
        <field name="complexity">medium</field>
        <field name="responsible_id" ref="demo_ip_carrasco" />
        <field name="goal_id" ref="demo_goal_capacitacion" />
        <field name="opening_date">2025-04-01</field>
        <field name="stage_id" ref="action_stage_open" />
    </record>
    <record id="demo_action_ciber" model="qms.action">
        <field name="name">Implementar copias de respaldo cifradas (Demo)</field>
        <field name="response_type">preventive</field>
        <field name="complexity">very_high</field>
        <field name="responsible_id" ref="demo_ip_referente" />
        <field name="hazard_id" ref="demo_hazard_ciber" />
        <field name="opening_date">2025-05-15</field>
        <field name="stage_id" ref="action_stage_open" />
    </record>
    <record id="demo_action_planif" model="qms.action">
        <field name="name">Redefinir objetivos con metas medibles (Demo)</field>
        <field name="response_type">correction</field>
        <field name="complexity">low</field>
        <field name="responsible_id" ref="demo_ip_quijano" />
        <field name="non_conformity_id" ref="demo_nc_planif" />
        <field name="opening_date">2025-10-10</field>
        <field name="stage_id" ref="action_stage_open" />
    </record>

    <!-- Effectiveness checks: closed ones need verification_date and
         verification_date >= expected_date; pending needs neither. -->
    <record id="demo_ec_compras" model="qms.effectiveness_check">
        <field name="action_id" ref="demo_action_compras" />
        <field name="expected_date">2025-05-15</field>
        <field name="verification_date">2025-06-16</field>
        <field name="state">closed</field>
        <field name="was_effective" eval="True" />
    </record>
    <record id="demo_ec_atencion" model="qms.effectiveness_check">
        <field name="action_id" ref="demo_action_atencion" />
        <field name="expected_date">2025-11-01</field>
        <field name="verification_date">2025-12-01</field>
        <field name="state">closed</field>
        <field name="was_effective" eval="False" />
        <field
            name="observations"
        >El circuito se aplica parcialmente; se reitera la accion.</field>
    </record>
    <record id="demo_ec_capac" model="qms.effectiveness_check">
        <field name="action_id" ref="demo_action_capac" />
        <field name="expected_date">2025-12-01</field>
        <field name="state">pending</field>
    </record>
</odoo>
